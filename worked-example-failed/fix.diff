+# FIX (worked failure, added to GPT-6 Astra's program): CalculiX's *BUCKLE search can miss factors well below 1.
+# Linear buckling scales exactly, lambda(a * P) = lambda(P) / a, so the same model is also run at 10 % of the load,
+# which moves every factor up by 10x, and the factors are scaled back. Both runs are real eigenvalues of the same
+# problem, so the smallest factor either run finds is the better (smaller) answer.
+LOW_LOAD = 0.1
+
+
+def write_scaled_loads(loads, scale):
+    src = OUTPUT / loads
+    dst = OUTPUT / loads.replace("_load.inc", f"_load_x{scale:g}.inc")
+    lines = src.read_text().splitlines()
+    with dst.open("w") as f:
+        f.write(lines[0] + "\n")
+        for line in lines[1:]:
+            n, dof, force = line.split(",")
+            f.write(f"{n},{dof},{float(force) * scale:.15g}\n")
+    return dst.name
+
+
 def main():
